# Public, non-secret frontend config only.
# Never put service_role keys, JWT secrets, or other backend credentials here.
# Empty values are expected until the client provides them.

# E.164 digits only, no plus — used later for WhatsApp deep links. Example: 573001112233
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Human-readable phone as shown in the UI. Example: +57 300 111 2233
NEXT_PUBLIC_PHONE_DISPLAY=

# tel: href value. Example: +573001112233
NEXT_PUBLIC_PHONE_TEL=

# Public contact email
NEXT_PUBLIC_CONTACT_EMAIL=test@test.com

# NestJS API base URL. Unused while www is static marketing content.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
